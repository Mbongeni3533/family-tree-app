{
  "name": "family-tree-app",
  "version": "1.0.0",
  "description": "Family Tree Application with Invitation-Only Access",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspaces",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "private": true,
  "keywords": ["family-tree", "genealogy", "dashboard"],
  "author": "Mbongeni J. Shongwe",
  "license": "MIT"
}